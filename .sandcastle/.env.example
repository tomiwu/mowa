# GitHub token. The agent and host use it to read and edit issues, push branches and open PRs.
# Fine-grained token for tomiwu/mowa: Contents (read and write), Issues (read and write),
# Pull requests (read and write), Actions (read), Metadata (read). Add Workflows (read and write)
# so that the agent can change .github/workflows/ci.yml (issue #3).
GH_TOKEN=
# Claude Code: set one of these. Prefer the subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional: Cursor agent (AGENT=cursor)
CURSOR_API_KEY=
